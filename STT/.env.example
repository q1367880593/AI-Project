# 翻译 API 类型: gemini, ollama, openai, deepl
TRANSLATION_API=gemini

# Google Gemini API（免费，推荐。TRANSLATION_API=gemini 时使用）
# 申请地址: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# Ollama 本地翻译（TRANSLATION_API=ollama 时使用）
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# OpenAI 兼容 API 配置（TRANSLATION_API=openai 时使用）
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# DeepL API 配置（TRANSLATION_API=deepl 时使用）
DEEPL_API_KEY=your-deepl-api-key-here

# Whisper 模型: tiny, base, small, medium, large-v2, large-v3
WHISPER_MODEL=large-v3

# 计算设备: auto, cpu, cuda
WHISPER_DEVICE=auto